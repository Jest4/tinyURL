<!DOCTYPE html>
<html lang="en">
<head>
    <title>TinyApp</title>
</head>
<header>
    <% include partials/_header %>
</header>
<body>
<table>
  <caption><h3>Your URLs </h3></caption>
  <tr>
    <th scope="col">Shortened</th>
  <th scope="col">Full URL</th>
  <th></th>
</tr>
    <% for (var shortURL in urls) { %>
  <tr> <th scope="row"><a href="<%=`/urls/${shortURL}`%>"><%= shortURL %> </a><td><a href="<%=`/u/${shortURL}`%>"> <%= urls[shortURL].longURL %></a><td><a href="<%=`/urls/${shortURL}`%>"><button type="button"> EDIT </button></a><td>
    <form method="POST" action="/urls/<%=`${shortURL}`%>?_method=DELETE"" id="deleteButton"> <input type="submit" value="DELETE" id="deleteButton"></form></tr>
  <% } %>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <title>TinyApp</title>
</head>
<header>
    <% include partials/_header %>
</header>
<body>
    <!-- Add your EJS code here -->
<table>
<tr><td><td>URL edit mode</tr></td></td>
  <th scope="row"><a href="<%=`/u/${shortURL}`%>">  <%= `${shortURL}` %></a></th> <form method="POST" action="/urls/<%=`${shortURL}`%>?_method=PUT" id="modifyButton"><td>
<input type="text" id="longURL" name="longURL" value="<%= `${longURL}` %>" required />
<button type="submit" form="modifyButton" value="Submit">Update</button></form></td>
<tr><td><td><a href="/urls">return to your URL index</a></tr></td></td>
<br>
</table>
<br>
<br>
<br>
This shortcut was created: <%= dbInfo.created %>
<p>This shortcut has been used <b><%=dbInfo.count%></b> times,
<br>by <b><%=dbInfo.uCount%></b> unique visitors.
<br>
<br>
<br>
Viewed by:
<% for (var user in dbInfo.viewed) {%>
<br>
<%= ` User: ${user} on`%> <br>&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp <%= dbInfo.viewed[user]%>
<% } %>

</body>
</html>
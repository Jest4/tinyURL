<!DOCTYPE html>
<html lang="en">
<head>
    <title>TinyApp</title>
</head>
<header>
    <% include partials/_header %>
</header>
<body>
<table>
  <caption> User Login </caption>
  <tr>
    <th scope="col">E-Mail</th>
  <th scope="col">Password</th>
</tr>
<tr>

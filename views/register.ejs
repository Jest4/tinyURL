<!DOCTYPE html>
<html lang="en">
<head>
    <title>TinyApp</title>
</head>
<header>
    <% include partials/_header %>
</header>
<body>
<table>
  <caption> User Registration </caption>
  <tr>
    <th scope="col">E-Mail</th>
  <th scope="col">Password</th>
  <th></th>
</tr>
<form>
   <form action="/register" method="POST" style="margin:150px;">
      <label for="longURL">Enter a URL:</label>
      <input id="longURL" type="text" name="longURL" placeholder="http://" style="width: 300px">
      <input type="submit" value="Submit">
    <% for (var shortURL in urls) { %>
  <tr> <th scope="row"><a href="<%=`/urls/${shortURL}`%>"><%= shortURL %> </a><td><a href="<%=`/u/${shortURL}`%>"> <%= urls[shortURL] %></a><td><a href="<%=`/urls/${shortURL}`%>"> EDIT </a><td>
    <form method="POST" action="/urls/<%=`${shortURL}`%>/delete" id="deleteButton"> <input type="submit" value="Delete" id="deleteButton"></form></tr>
  <% } %>
</body>
</html>
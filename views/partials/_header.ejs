<!DOCTYPE html>
<html lang="en">
<head>
  <h3>Welcome to TinyApp!</h3>
   <% if (locals.user_id) { %>
    <p>
    <form method="POST" action="/logout" id="logout" name="logout" type="submit" value="logout">
      Logged in as: <%= user_id.email %>
    <button type="submit" form="logout" value="Logout">Logout</button></form>
    <a href="/urls">[ Main ]</a>
    <a href="/urls/new">[ New ]</a> </p>
   <% } else { %>
  <a href="/urls">[ Main ]</a>
  <a href="/login">[ Login ]</a>
  <a href="/register">[ Register ]</a>
<% }%>

</head>
<body>
</body>
</html>